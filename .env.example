# Copy to .env and adjust. Only JWT_SECRET is strictly required.

# HTTP / gRPC
HTTP_PORT=8080
GRPC_PORT=9090

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB=usermgmt

# JWT (HS256)
JWT_SECRET=dev-super-secret-change-me
JWT_ISSUER=user-management-api
JWT_TTL=24h

# bcrypt cost (4 for fast tests, 10-12 for production)
BCRYPT_COST=10

# Background job: how often to log the user count
USER_COUNT_INTERVAL=10s

# Graceful shutdown budget
SHUTDOWN_TIMEOUT=10s

# Require a Bearer token in gRPC metadata (authorization key)
GRPC_AUTH=false

# Logging: debug | info | warn | error
LOG_LEVEL=info
