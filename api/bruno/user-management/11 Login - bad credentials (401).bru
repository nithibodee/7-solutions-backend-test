meta {
  name: 11 Login - bad credentials (401)
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "alice@example.com",
    "password": "wrong-password"
  }
}

assert {
  res.status: eq 401
  res.body.error.code: eq invalid_credentials
}
