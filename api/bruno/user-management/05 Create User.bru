meta {
  name: 05 Create User
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/users
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "name": "Bob",
    "email": "bob@example.com",
    "password": "password123"
  }
}

assert {
  res.status: in [201, 409]
}

docs {
  Authenticated admin-style create. Same body/rules as Register - 201 on a
  fresh DB, 409 if bob@example.com already exists from a previous run.
}
